# Formulaire de contact — Formspree (gratuit : https://formspree.io)
# 1. Créez un compte et un formulaire sur Formspree
# 2. Copiez ce fichier vers .env et collez l'URL de votre formulaire :
#    VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/VOTRE_ID
# Sans cette variable, le formulaire ouvre le client mail (mailto) en repli.
VITE_FORMSPREE_ENDPOINT=
